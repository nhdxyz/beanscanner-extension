{
  "manifest_version": 3,
  "name": "BeanScanner",
  "version": "1.0.0",
  "description": "beanscanner.xyz | An extension to quickly analyze and buy solana tokens.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "analyze": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Analyze the current token"
    },
    "buy": {
      "suggested_key": {
        "default": "Ctrl+Shift+O"
      },
      "description": "Buy the current token"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://*.dexscreener.com/*",
    "*://*.photon-sol.tinyastro.io/*",
    "*://*.birdeye.so/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
